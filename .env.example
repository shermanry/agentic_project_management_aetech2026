# Copy to .env and fill in. Never commit .env (it's git-ignored).

# OpenRouter (shared hosted models, incl. google/gemini-embedding-2). Ask Ryan for the key.
OPENROUTER_API_KEY=

# Embeddings - used by src/api/embeddings.py.
# "local" (default) = EmbeddingGemma 2 on Ryan's laptop (text, images, video, audio).
# "openrouter" = Gemini Embedding 2 (hosted fallback if the local server is unreachable).
# Vectors from different providers/models are NOT comparable - keep one index per model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Local EmbeddingGemma 2 server (same Wi-Fi). From Docker on Ryan's Mac use http://host.docker.internal:8000. Ask Ryan for a key.
LOCAL_EMBEDDING_URL=http://10.70.4.24:8000
LOCAL_EMBEDDING_KEY=
