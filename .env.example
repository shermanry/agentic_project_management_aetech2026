# Copy to .env and fill in. Never commit .env (it's git-ignored).

# OpenRouter (shared hosted models, incl. google/gemini-embedding-2). Ask Ryan for the key.
OPENROUTER_API_KEY=

# Which embedding backend to use: "openrouter" (Gemini Embedding 2) or "local" (EmbeddingGemma 2 on Ryan's laptop).
# Vectors from the two backends are NOT comparable - keep one index per backend.
EMBED_BACKEND=openrouter

# Local EmbeddingGemma 2 server (same Wi-Fi). Ask Ryan for a key.
LOCAL_EMBED_URL=http://10.70.4.24:8000
LOCAL_EMBED_KEY=
